#
# mod-gathering-yield
#
# Loot counts are vanilla in the database. These multipliers are applied at runtime.
# Companion skill-up rate (core worldserver.conf, not this file):
#   SkillGain.Gathering = 3
#
[worldserver]

# GatheringYield.Multiplier
#        Description: Multiplies only the maximum stack from mining, herbalism, fishing, skinning,
#                     gas-cloud extraction, and elemental extraction. The minimum stays at the stock count.
#                     A 1–3 node at 10 becomes 1–30. 1 keeps vanilla counts.
#                     Database loot counts must stay at stock values; this is the only multiplier.
#                     Fishing trunks and crates are not multiplied.
#        Default:     3
#        Reload:      yes (next gather)
GatheringYield.Multiplier = 3

# GatheringYield.DailyTokenMultiplier
#        Description: Currency-token rewards from daily quests, including heroic dungeon dailies.
#                     Covers emblems, seals, cooking awards, jewelcrafting tokens, and other currency tokens.
#                     Weekly quests are unchanged. 1 keeps vanilla amounts.
#        Default:     3
#        Reload:      yes (next quest query / turn-in)
GatheringYield.DailyTokenMultiplier = 3
